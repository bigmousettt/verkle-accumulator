+/*
+ * Reconstructing an f-part base-B decomposition multiplies the extracted
+ * opening bound by 1 + B + ... + B^(f-1).  For the common f=2 case this is
+ * the (b+1) factor in AAB+24, Theorem 5.2 and Appendix I.5.
+ */
+static double opening_reconstruction_factor(const comparams *cpp) {
+  size_t i;
+  double factor = 0.0;
+  for(i=0;i<cpp->f;i++)
+    factor += ldexp(1,i*cpp->b);
+  return factor;
+}
